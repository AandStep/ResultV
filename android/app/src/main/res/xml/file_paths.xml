<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CertInstaller.buildShareIntent copies ca.crt here before sharing,
         so this points at a dedicated cacheDir subdirectory that never
         contains anything else — NOT files/filter/, which also holds
         ca.key (the CA private key) and cached filter lists. Pinning
         <files-path> at an exact filename instead of a directory was tried
         and crashes AndroidX FileProvider's SimplePathStrategy with a
         StringIndexOutOfBoundsException (confirmed via live device test);
         entries here must name directories. -->
    <cache-path name="cert" path="share_cert/" />
</paths>
