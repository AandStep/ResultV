<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ResultV" parent="android:Theme.Material.NoActionBar" />

    <!-- Cold-start splash. Activity's manifest theme; MainActivity
         calls setTheme(R.style.Theme_ResultV) in onCreate() before
         super.onCreate so the splash window background is replaced
         the moment Compose takes over. -->
    <style name="Theme.ResultV.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <!-- statusBarColor / navigationBarColor are deliberately absent: API 35
             made edge-to-edge mandatory and ignores both, so setting them would
             only mislead. Transparent bars let splash_background (#FF060608 with
             the logo) show through the bar areas on every API level, which is
             what 35+ does anyway. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
