<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to enumerate other apps for the per-app routing picker on
         Android 11+. VPN-per-app routing is one of the policy-approved
         justifications for this permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ResultV">

        <!-- Preload Play Services' Code Scanner module so the first QR
             scan on AddScreen doesn't pay a download stall. Silent on
             devices that already have the module. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ResultV.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-link import: resultv://import/<base64>, resultv://rvsub/...,
                 resultv:import/... (opaque). MainActivity decodes via
                 Mobile.decodeDeepLink and hands off to the standard import path. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="resultv" />
            </intent-filter>
        </activity>

        <!-- VPN service: BIND_VPN_SERVICE is the only permission Android
             trusts for VpnService implementations. The intent filter is
             what makes VpnService.prepare() recognise this service. -->
        <service
            android:name=".vpn.ResultVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile: one-tap connect/disconnect from the
             system pull-down. BIND_QUICK_SETTINGS_TILE is the only
             permission the OS trusts for TileService. -->
        <service
            android:name=".vpn.ResultVTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Exposes files/filter/ca.crt via a content:// URI so the user can
             share/save the browser ad-block CA certificate through Android's
             system share sheet, then install it manually via Settings ->
             Encryption & credentials (KeyChain.createInstallIntent() only
             shows an informational dialog on Android 7+, it does not install
             directly — the user needs an actual file to pick in that flow). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
